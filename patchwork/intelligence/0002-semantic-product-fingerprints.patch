+fn hash_diagnostic_fix(fix: &DiagnosticFix, hasher: &mut impl Hasher) {
+    fix.message.hash(hasher);
+    match &fix.replacement {
+        Some((range, text)) => {
+            1u8.hash(hasher);
+            hash_range(*range, hasher);
+            text.hash(hasher);
+        }
+        None => 0u8.hash(hasher),
+    }
+}
