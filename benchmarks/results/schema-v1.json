{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Phalcom BenchmarkRun Schema v1",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "timestamp",
    "git",
    "build",
    "host",
    "layouts",
    "command",
    "suite",
    "resource_quality",
    "cases",
    "summary"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "run_id": { "type": "string" },
    "timestamp": { "type": "integer" },
    "resource_quality": { "type": "string", "enum": ["full", "wall_only"] }
  }
}
