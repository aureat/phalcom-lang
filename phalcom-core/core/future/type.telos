// Type-system/reflection vocabulary

type data Variance {
    Covariant
    Contravariant
    Invariant
}

type data DeclarationPhase {
    Runtime
    TypeOnly
}

type data AlgebraicShape {
    Product
    Sum
}

type data ProductShape {
    Tuple
    Record
}

type data CaseShape {
    Singleton
    Tuple
    Record
}

type data ImplementationOrigin {
    Phalcom
    Native
    Intrinsic
}

type data GenericParameterMode {
    Single
    PositionalPack
    LabeledPack
    CompletePack
}

type data Mutability {
    Immutable
    Mutable
}

type data Access {
    Read
    Write
    ReadWrite
}
