// status: PENDING
from universe.functional import Chain, NonEmpty
let original = Chain<Int>::Empty.prepend(3).prepend(2).prepend(1)
let extended = original.prepend(0)
System.print(original.size)
System.print(extended.size)
System.print(extended.tail == original)
System.print(original.at(2).unwrap)
System.print(original.at(-1).isNone)
System.print(original.map(|n| { n * 2 }).fold(initial: 0, using: |a, b| { a + b }))
System.print(original.flatMap(|n| { Chain<Int>::Empty.prepend(n).prepend(n) }).size)
System.print(original.take(2).fold(initial: 0, using: |a, b| { a + b }))
System.print(original.drop(1).first.unwrap)
let parts = original.partition(|n| { n % 2 == 0 })
System.print(parts.matching.size)
System.print(parts.remaining.size)
System.print(Chain<Int>.fromIterable(original) == original)
let nonempty = NonEmpty<Int>.one(4).append(NonEmpty<Int>.one(5))
System.print(nonempty.reduce(|a, b| { a + b }))
System.print(nonempty.filter(|_| { false }).isEmpty)
System.print(NonEmpty<Int>.fromChain(Chain<Int>::Empty).isNone)
