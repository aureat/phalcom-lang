+    Resolved(ResolvedProjectId),
+    Synthetic(SyntheticProjectId),
+}
+
+impl fmt::Display for ProjectIdentity {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
