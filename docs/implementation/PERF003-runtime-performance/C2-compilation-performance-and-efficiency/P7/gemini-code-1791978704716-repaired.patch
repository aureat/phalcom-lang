@@ -0,0 +1,55 @@
+//! Cross-validation of pending static references and witness slot fingerprints (`PERF003.C2.P7.T7.B`).
+
+use crate::static_value::artifact::StaticRelocation;
+use phalcom_compiler_artifact::semantic::aggregates::StructuralPrimaryContractsV1;
+use phalcom_compiler_artifact::{ArtifactError, ValidationError};
+use phalcom_type_meta::identity::StableCallableRef;
+
+fn invalid(message: impl Into<String>) -> ArtifactError {
+    ValidationError::ReferentialIntegrity(message.into()).into()
+}
+
+/// Verifies that every `PendingStaticValueRefV1` recorded during `T7.A` structural
+/// contract loading resolves in the `T6` `StaticRelocation` before publication.
+pub fn validate_pending_static_references(
+    contracts: &StructuralPrimaryContractsV1,
+    statics: &StaticRelocation,
+) -> Result<(), ArtifactError> {
+    for sig in &contracts.generic_signatures {
+        for constraint in &sig.constraints {
+            if let Some(pending) = &constraint.pending_static {
+                statics.value(pending.target_value)?;
+            }
+        }
+    }
+    for data in &contracts.data_contracts {
+        for component in &data.components {
+            if let Some(pending) = &component.default_static {
+                statics.value(pending.target_value)?;
+            }
+        }
+    }
+    for enm in &contracts.enum_contracts {
+        for variant in &enm.variants {
+            if let Some(pending) = &variant.discriminant_static {
+                statics.value(pending.target_value)?;
+            }
+            for field in &variant.fields {
+                if let Some(pending) = &field.default_static {
+                    statics.value(pending.target_value)?;
+                }
+            }
+        }
+    }
+    Ok(())
+}
+
+pub fn compute_witness_layout_fingerprint(callables: &[StableCallableRef]) -> [u8; 32] {
+    let mut digest = [0u8; 32];
+    for (idx, callable) in callables.iter().enumerate() {
+        for (b_idx, byte) in callable.selector.as_bytes().iter().enumerate() {
+            digest[b_idx % 32] ^= byte.wrapping_add(idx as u8);
+        }
+    }
+    digest
+}
