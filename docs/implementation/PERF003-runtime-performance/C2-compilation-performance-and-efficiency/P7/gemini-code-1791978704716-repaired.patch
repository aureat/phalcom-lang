+//! Exhaustive field-to-wire/derived/omitted coverage manifest (`PERF003.C2.P7.T0/T5`).
+
+use crate::canonical_image::{CanonicalPersistenceClass, CanonicalProductFamily};
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum PortableDisposition {
+    Wire { section: &'static str },
+    Derived { owner: &'static str },
+    Omitted { reason: &'static str },
+}
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub struct SnapshotFieldCoverage {
+    pub field: &'static str,
+    pub family: CanonicalProductFamily,
+    pub disposition: PortableDisposition,
+    pub compiler_readers: &'static [&'static str],
+}
+
+pub const SNAPSHOT_FIELD_COVERAGE_MANIFEST: &[SnapshotFieldCoverage] = &[
+    SnapshotFieldCoverage {
+        field: "store",
+        family: CanonicalProductFamily::TypeArena,
+        disposition: PortableDisposition::Wire { section: "SEMANTIC_WORLD::type_graph" },
+        compiler_readers: &["ProgramCompiler", "TypeChecker", "MetadataExporter"],
+    },
+    SnapshotFieldCoverage {
+        field: "static_values",
+        family: CanonicalProductFamily::StaticValueArena,
+        disposition: PortableDisposition::Wire { section: "SEMANTIC_WORLD::static_values" },
+        compiler_readers: &["StaticEvaluator", "TypeStore", "ConstantLowering"],
+    },
+    SnapshotFieldCoverage {
+        field: "declarations",
+        family: CanonicalProductFamily::DeclarationsAndAliases,
+        disposition: PortableDisposition::Wire { section: "SEMANTIC_WORLD::aggregates" },
+        compiler_readers: &["ProgramCompiler", "NameResolver", "MetadataExporter"],
+    },
+    SnapshotFieldCoverage {
+        field: "type_aliases",
+        family: CanonicalProductFamily::DeclarationsAndAliases,
+        disposition: PortableDisposition::Wire { section: "SEMANTIC_WORLD::aggregates" },
+        compiler_readers: &["TypeChecker", "MetadataExporter"],
+    },
+    SnapshotFieldCoverage {
+        field: "hierarchy",
+        family: CanonicalProductFamily::HierarchyAndDispatch,
+        disposition: PortableDisposition::Wire { section: "SEMANTIC_WORLD::aggregates" },
+        compiler_readers: &["SubtypingEngine", "SurfaceDispatchResolver"],
+    },
+    SnapshotFieldCoverage {
+        field: "surfaces",
+        family: CanonicalProductFamily::HierarchyAndDispatch,
+        disposition: PortableDisposition::Wire { section: "SEMANTIC_WORLD::primary" },
+        compiler_readers: &["SurfaceDispatchResolver", "MetadataExporter"],
+    },
+    SnapshotFieldCoverage {
+        field: "dispatch",
+        family: CanonicalProductFamily::HierarchyAndDispatch,
+        disposition: PortableDisposition::Wire { section: "SEMANTIC_WORLD::primary" },
+        compiler_readers: &["ProgramCompiler", "CallChecker"],
+    },
+    SnapshotFieldCoverage {
+        field: "callable_signatures",
+        family: CanonicalProductFamily::CallableSignaturesAndDefinitions,
+        disposition: PortableDisposition::Wire { section: "SEMANTIC_WORLD::primary" },
+        compiler_readers: &["ProgramCompiler", "CallChecker", "MetadataExporter"],
+    },
+    SnapshotFieldCoverage {
+        field: "callable_definitions",
+        family: CanonicalProductFamily::CallableSignaturesAndDefinitions,
+        disposition: PortableDisposition::Wire { section: "SEMANTIC_WORLD::primary" },
+        compiler_readers: &["ProgramCompiler", "ModuleLoweringSemantics"],
+    },
+    SnapshotFieldCoverage {
+        field: "callable_definitions_by_module",
+        family: CanonicalProductFamily::CallableSignaturesAndDefinitions,
+        disposition: PortableDisposition::Derived { owner: "SemanticSnapshot::with_callable_definitions" },
+        compiler_readers: &["SemanticSnapshot::callable_definitions_in_module"],
+    },
+    SnapshotFieldCoverage {
+        field: "callable_analyses",
+        family: CanonicalProductFamily::CallableAnalyses,
+        disposition: PortableDisposition::Wire { section: "SEMANTIC_WORLD::primary" },
+        compiler_readers: &["ProgramCompiler", "ModuleLoweringSemantics"],
+    },
+    SnapshotFieldCoverage {
+        field: "source_index",
+        family: CanonicalProductFamily::CompilerSourceAttachments,
+        disposition: PortableDisposition::Wire { section: "SEMANTIC_WORLD::attachments" },
+        compiler_readers: &["ProgramCompiler", "FormalSemanticProjection"],
+    },
+    SnapshotFieldCoverage {
+        field: "sources",
+        family: CanonicalProductFamily::ModulesAndInterfaces,
+        disposition: PortableDisposition::Omitted { reason: "Raw ParsedModuleUnit AST excluded from source-free universe.telosc" },
+        compiler_readers: &[],
+    },
+];
+
+pub const fn disposition_for_family(family: CanonicalProductFamily) -> (CanonicalPersistenceClass, PortableDisposition) {
+    match family {
+        CanonicalProductFamily::ModulesAndInterfaces | CanonicalProductFamily::ImportsAndTopology => (
+            CanonicalPersistenceClass::RequiredSemantic,
+            PortableDisposition::Wire { section: "MODULE_WORLD" },
+        ),
+        CanonicalProductFamily::TypeArena
+        | CanonicalProductFamily::StaticValueArena
+        | CanonicalProductFamily::DeclarationsAndAliases
+        | CanonicalProductFamily::HierarchyAndDispatch
+        | CanonicalProductFamily::CallableSignaturesAndDefinitions
+        | CanonicalProductFamily::CallableAnalyses
+        | CanonicalProductFamily::TraitsAndConformance
+        | CanonicalProductFamily::ConformanceWitnessesAndDispatch
+        | CanonicalProductFamily::DataAndEnums
+        | CanonicalProductFamily::AssociatedAndStaticSemantics
+        | CanonicalProductFamily::CompilerSourceAttachments => (
+            CanonicalPersistenceClass::RequiredSemantic,
+            PortableDisposition::Wire { section: "SEMANTIC_WORLD" },
+        ),
+        CanonicalProductFamily::FrozenStructuralQueries => (
+            CanonicalPersistenceClass::EligibleQuery,
+            PortableDisposition::Wire { section: "QUERY_IMAGE" },
+        ),
+        CanonicalProductFamily::RuntimePublicMetadata => (
+            CanonicalPersistenceClass::RequiredMetadata,
+            PortableDisposition::Wire { section: "METADATA" },
+        ),
+        CanonicalProductFamily::EditorPresentation
+        | CanonicalProductFamily::AdvisoryProducts
+        | CanonicalProductFamily::SourceMaps
+        | CanonicalProductFamily::Diagnostics
+        | CanonicalProductFamily::WorkspaceRevisionHistory
+        | CanonicalProductFamily::MutableSemanticDatabase
+        | CanonicalProductFamily::RuntimeHandles => (
+            CanonicalPersistenceClass::NeverPersist,
+            PortableDisposition::Omitted { reason: "Non-compiler-image or process-local family" },
+        ),
+    }
+}
