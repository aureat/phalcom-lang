+use phalcom_compiler_artifact::semantic::type_store::{ArtifactTypeId, TypeGraphV1};
+use phalcom_type_meta::identity::{StableCallableRef, StableDeclarationRef, StableImplRef};
+
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub enum OperationalOperandV1 {
+    Slot(u16),
+    StaticValue(ArtifactStaticValueId),
+    Type(ArtifactTypeId),
+}
+
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct CheckedOperationalStepV1 {
+    pub opcode: u16,
+    pub dst_slot: u16,
+    pub operands: Vec<OperationalOperandV1>,
+}
+
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct CheckedOperationalTemplateV1 {
+    pub owner: StableDeclarationRef,
+    pub slot_types: Vec<ArtifactTypeId>,
+    pub result_type: ArtifactTypeId,
+    pub steps: Vec<CheckedOperationalStepV1>,
+}
+
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct WitnessPlanV1 {
+    pub impl_id: StableImplRef,
+    pub trait_decl: StableDeclarationRef,
+    pub target_type: ArtifactTypeId,
+    pub ordered_selected_callables: Vec<StableCallableRef>,
+    pub slot_layout_fingerprint: [u8; 32],
+}
+
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct SemanticWorldV1 {
+    pub type_graph: TypeGraphV1,
+    pub structural_contracts: StructuralPrimaryContractsV1,
+    pub static_values: StaticValueGraphV1,
+    pub witness_plans: Vec<WitnessPlanV1>,
+    pub checked_templates: Vec<CheckedOperationalTemplateV1>,
+}
+
+pub struct SemanticExportContext {
+    pub types: TypeExportContext,
+    pub statics: StaticExportContext,
+    pub blocked_families: Vec<(CanonicalProductFamily, &'static str)>,
+}
