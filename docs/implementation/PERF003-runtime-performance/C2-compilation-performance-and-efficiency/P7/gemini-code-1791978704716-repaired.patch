@@ -0,0 +1,126 @@
+//! Static-value graph export, iterative validation, and fresh-store relocation (`PERF003.C2.P7.T6`).
+
+use super::store::{
+    StaticPackBackingId, StaticStringId, StaticSymbolId, StaticValueId, StaticValueRef,
+    StaticValueStore, StaticValueStoreId,
+};
+use phalcom_compiler_artifact::semantic::static_value::{
+    ArtifactStaticPackBackingId, ArtifactStaticStringId, ArtifactStaticSymbolId,
+    ArtifactStaticValueId, StaticValueGraphV1, StaticValueV1,
+};
+use phalcom_compiler_artifact::{ArtifactError, ValidationError, ValidationLimits};
+use std::collections::BTreeMap;
+
+fn invalid(message: impl Into<String>) -> ArtifactError {
+    ValidationError::ReferentialIntegrity(message.into()).into()
+}
+
+pub struct StaticExportContext {
+    store_id: StaticValueStoreId,
+    values: BTreeMap<StaticValueId, ArtifactStaticValueId>,
+}
+
+impl StaticExportContext {
+    pub fn new(store: &StaticValueStore) -> Self {
+        let values = (0..store.len() as u32)
+            .map(|idx| (StaticValueId(idx), ArtifactStaticValueId(idx)))
+            .collect();
+        Self {
+            store_id: store.id(),
+            values,
+        }
+    }
+
+    pub fn verify_store(&self, store: &StaticValueStore) -> Result<(), ArtifactError> {
+        if store.id() != self.store_id {
+            return Err(invalid("foreign StaticValueStore lineage in StaticExportContext"));
+        }
+        Ok(())
+    }
+
+    pub fn export_value(&self, value: StaticValueRef) -> Result<ArtifactStaticValueId, ArtifactError> {
+        if value.store_id() != self.store_id {
+            return Err(invalid("foreign StaticValueRef store lineage"));
+        }
+        self.values
+            .get(&value.value_id())
+            .copied()
+            .ok_or_else(|| invalid("out-of-range StaticValueId in StaticExportContext"))
+    }
+}
+
+#[derive(Debug)]
+pub struct StaticRelocation {
+    pub store_id: StaticValueStoreId,
+    pub values: Vec<StaticValueRef>,
+    pub strings: Vec<StaticStringId>,
+    pub symbols: Vec<StaticSymbolId>,
+    pub pack_backings: Vec<StaticPackBackingId>,
+}
+
+impl StaticRelocation {
+    pub fn value(&self, id: ArtifactStaticValueId) -> Result<StaticValueRef, ArtifactError> {
+        self.values
+            .get(id.0 as usize)
+            .copied()
+            .ok_or_else(|| invalid("out-of-range relocated static value reference"))
+    }
+
+    pub fn string(&self, id: ArtifactStaticStringId) -> Result<StaticStringId, ArtifactError> {
+        self.strings
+            .get(id.0 as usize)
+            .copied()
+            .ok_or_else(|| invalid("out-of-range relocated static string reference"))
+    }
+
+    pub fn symbol(&self, id: ArtifactStaticSymbolId) -> Result<StaticSymbolId, ArtifactError> {
+        self.symbols
+            .get(id.0 as usize)
+            .copied()
+            .ok_or_else(|| invalid("out-of-range relocated static symbol reference"))
+    }
+
+    pub fn pack_backing(&self, id: ArtifactStaticPackBackingId) -> Result<StaticPackBackingId, ArtifactError> {
+        self.pack_backings
+            .get(id.0 as usize)
+            .copied()
+            .ok_or_else(|| invalid("out-of-range relocated static pack backing reference"))
+    }
+}
+
+/// Iteratively validates `StaticValueGraphV1` bounds, pack slice ranges, and acyclicity (`P7.T6`).
+pub fn validate_static_graph_bounds(
+    graph: &StaticValueGraphV1,
+    limits: &ValidationLimits,
+) -> Result<(), ArtifactError> {
+    for s in &graph.strings {
+        if s.len() > limits.max_string_bytes {
+            return Err(invalid("static string exceeds max_string_bytes"));
+        }
+    }
+    for sym in &graph.symbols {
+        if sym.len() > limits.max_string_bytes {
+            return Err(invalid("static symbol exceeds max_string_bytes"));
+        }
+    }
+    for pack in &graph.packs {
+        let backing = graph
+            .pack_backings
+            .get(pack.backing.0 as usize)
+            .ok_or_else(|| invalid("static pack references out-of-range pack backing"))?;
+        let pos_end = (pack.positional_start as usize).saturating_add(pack.positional_len as usize);
+        let lab_end = (pack.labeled_start as usize).saturating_add(pack.labeled_len as usize);
+        if pos_end > backing.positionals.len() || lab_end > backing.labels.len() || backing.labels.len() != backing.labeled_values.len() {
+            return Err(invalid("static pack slice exceeds backing bounds"));
+        }
+    }
+    for (idx, value) in graph.values.iter().enumerate() {
+        if let StaticValueV1::Tuple { id } = value {
+            let elems = graph.tuples.get(id.0 as usize).ok_or_else(|| invalid("out-of-range static tuple"))?;
+            if elems.is_empty() || elems.iter().any(|child| (child.0 as usize) >= idx) {
+                return Err(invalid("non-topological or cyclic static tuple child"));
+            }
+        }
+    }
+    Ok(())
+}
