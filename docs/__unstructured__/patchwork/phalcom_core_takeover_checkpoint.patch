+fn hash_import_surface(import: &ImportSurface, hasher: &mut impl Hasher) {
+    match import {
+        ImportSurface::Module(import) => {
+            0u8.hash(hasher);
+            hash_import_path(&import.path, hasher);
+            import.alias.as_ref().map(|alias| alias.name.as_str()).hash(hasher);
+        }
+        ImportSurface::Selective(import) => {
