@@ -0,0 +1,84 @@
+use phalcom_modules::source::{OverlaySourceProvider, SourceOverlay};
+use phalcom_modules::{
+    ModuleId, ModuleKind, ModulePath, ModuleResolutionError, ResolvedProject, SourceError,
+    SourceId, SourceLocation, SourceProvider, SourceUnit, SyntheticProjectIdAllocator,
+};
+use std::collections::BTreeMap;
+use std::sync::Arc;
+
+#[derive(Default)]
+struct MemoryProvider {
+    sources: BTreeMap<SourceId, Arc<str>>,
+}
+
+impl SourceProvider for MemoryProvider {
+    fn locate(
+        &self,
+        _project: &ResolvedProject,
+        _path: &ModulePath,
+    ) -> Result<SourceUnit, ModuleResolutionError> {
+        Err(ModuleResolutionError::ModuleNotFound("memory provider".into()))
+    }
+
+    fn read(&self, source: &SourceId) -> Result<Arc<str>, SourceError> {
+        self.sources
+            .get(source)
+            .cloned()
+            .ok_or_else(|| SourceError::NotFound(source.to_string()))
+    }
+}
+
+fn module() -> ModuleId {
+    let mut ids = SyntheticProjectIdAllocator::default();
+    ModuleId::synthetic(ids.allocate(), ModulePath::root())
+}
+
+fn overlay(module: ModuleId, source: SourceId, text: &str) -> SourceOverlay {
+    SourceOverlay::new(
+        module,
+        ModuleKind::Module,
+        SourceLocation {
+            source_id: source,
+            display_path: "memory.ph".into(),
+        },
+        Arc::from(text),
+    )
+}
+
+#[test]
+fn replacing_overlay_removes_previous_source_reverse_mapping() {
+    let module = module();
+    let old_source = SourceId("memory://old".into());
+    let new_source = SourceId("memory://new".into());
+    let mut base = MemoryProvider::default();
+    base.sources.insert(old_source.clone(), Arc::from("disk old"));
+    base.sources.insert(new_source.clone(), Arc::from("disk new"));
+    let provider = OverlaySourceProvider::new(base);
+
+    provider.set_overlay(overlay(module.clone(), old_source.clone(), "overlay old"));
+    assert_eq!(provider.read(&old_source).unwrap().as_ref(), "overlay old");
+
+    provider.set_overlay(overlay(module, new_source.clone(), "overlay new"));
+
+    assert_eq!(
+        provider.read(&old_source).unwrap().as_ref(),
+        "disk old",
+        "the replaced source id must fall through to the base provider",
+    );
+    assert_eq!(provider.read(&new_source).unwrap().as_ref(), "overlay new");
+}
+
+#[test]
+fn removing_overlay_restores_base_source() {
+    let module = module();
+    let source = SourceId("memory://module".into());
+    let mut base = MemoryProvider::default();
+    base.sources.insert(source.clone(), Arc::from("disk"));
+    let provider = OverlaySourceProvider::new(base);
+
+    provider.set_overlay(overlay(module.clone(), source.clone(), "overlay"));
+    assert_eq!(provider.read(&source).unwrap().as_ref(), "overlay");
+
+    provider.remove_overlay(&module);
+    assert_eq!(provider.read(&source).unwrap().as_ref(), "disk");
+}
