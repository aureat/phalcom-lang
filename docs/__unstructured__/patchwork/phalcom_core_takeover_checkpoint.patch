+#[test]
+fn body_only_source_edit_keeps_unlinked_interface_product_stable() {
+    let module = module();
+    let before = phalcom_ast::parse("class A { value() -> Int { 1 } }", 0);
+    let after = phalcom_ast::parse("class A { value() -> Int { 2 } }", 0);
+
+    let before = InterfaceBuilder::build(module.clone(), ModuleKind::Module, &before.program)
+        .expect("before interface");
+    let after = InterfaceBuilder::build(module, ModuleKind::Module, &after.program)
+        .expect("after interface");
+
+    assert_eq!(
+        unlinked_interface_product_fingerprint(&before),
+        unlinked_interface_product_fingerprint(&after),
+        "callable implementation bodies are not part of a module interface product",
+    );
+}
