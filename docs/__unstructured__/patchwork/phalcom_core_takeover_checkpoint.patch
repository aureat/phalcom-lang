+/// Computes the product fingerprint for a callable semantic signature.
+///
+/// Source spans are provenance and are excluded. All callable contract fields
+/// that can affect checking, reflection, or editor presentation are included.
+pub fn callable_signature_product_fingerprint(
+    signature: &CallableSemanticSignature,
+) -> ProductFingerprint {
+    let mut hasher = DefaultHasher::new();
+    signature.callable.hash(&mut hasher);
+    signature.owner.hash(&mut hasher);
+    signature.side.hash(&mut hasher);
+    signature.selector.hash(&mut hasher);
+    hash_generic_signature(signature.generics.as_ref(), &mut hasher);
+    for parameter in signature.parameters.iter() {
+        parameter.index.hash(&mut hasher);
+        parameter.local_name.hash(&mut hasher);
+        parameter.external_label.hash(&mut hasher);
+        hash_rest_mode(parameter.rest, &mut hasher);
+        hash_type_term(&parameter.ty, &mut hasher);
+    }
+    hash_type_term(&signature.return_type, &mut hasher);
+    signature.implementation.hash(&mut hasher);
+    signature.native_id.hash(&mut hasher);
+    signature.effects.hash(&mut hasher);
+    signature.raises.hash(&mut hasher);
+    signature.flow.hash(&mut hasher);
+    signature.lifecycle.hash(&mut hasher);
+    ProductFingerprint::new(hasher.finish())
+}
