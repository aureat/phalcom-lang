+/// Computes the semantic product fingerprint for a fully linked component.
+pub fn semantic_component_product_fingerprint(program: &LinkedProgram) -> ProductFingerprint {
+    let mut hasher = DefaultHasher::new();
+    hash_project_universe(&program.universe, &mut hasher);
+    program.entry.hash(&mut hasher);
+    program.initialization_order.hash(&mut hasher);
+
+    for (module_id, module) in &program.modules {
+        module_id.hash(&mut hasher);
+        linked_interface_product_fingerprint(&module.interface).hash(&mut hasher);
+
+        for (name, id) in &module.bindings.local_globals {
+            name.hash(&mut hasher);
+            id.0.hash(&mut hasher);
+        }
+        for (name, id) in &module.bindings.imports {
+            name.hash(&mut hasher);
+            id.0.hash(&mut hasher);
+        }
+        for read in &module.linked_reads {
+            match read {
+                phalcom_modules::LinkedReadSpec::Module(target) => {
+                    0u8.hash(&mut hasher);
+                    target.hash(&mut hasher);
+                }
+                phalcom_modules::LinkedReadSpec::Binding(symbol) => {
+                    1u8.hash(&mut hasher);
+                    symbol.module.hash(&mut hasher);
+                    symbol.name.hash(&mut hasher);
+                }
+            }
+        }
+        let mut runtime_dependencies = module.runtime_dependencies.clone();
+        runtime_dependencies.sort();
+        runtime_dependencies.dedup();
+        runtime_dependencies.hash(&mut hasher);
+    }
+
+    hash_module_graphs(program, &mut hasher);
+    ProductFingerprint::new(hasher.finish())
+}
