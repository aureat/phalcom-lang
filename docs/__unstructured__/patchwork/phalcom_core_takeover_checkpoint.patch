+//! Query-owned callable signature products used for dependency invalidation.
+//!
+//! Formal declaration surfaces may contain `Known`, `Unknown`, or `Dynamic`
+//! type knowledge. The semantic database must preserve that complete state so
+//! unannotated callables still have a dependency-trackable signature product.
+//! Reflection-oriented [`crate::signature::CallableSemanticSignature`] values
+//! are a stricter projection and therefore are not used as the database's
+//! invalidation payload.
+
+use crate::dispatch::CallableSignature;
+use crate::identity::CallableId;
+
+/// Canonical query product for one callable's declaration-time signature.
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct CallableSignatureProduct {
+    /// Canonical callable identity.
+    pub callable: CallableId,
+    /// Declaration-time signature preserving `Known`/`Unknown`/`Dynamic` type knowledge.
+    pub signature: CallableSignature,
+}
+
+impl CallableSignatureProduct {
+    /// Creates a signature product from its canonical callable identity and surface contract.
+    pub fn new(callable: CallableId, signature: CallableSignature) -> Self {
+        Self { callable, signature }
+    }
+}
