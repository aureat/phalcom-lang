+/// Returns the canonical callable identity used to analyze a source method body.
+///
+/// Constructors have two semantic identities: the source-visible class-side
+/// factory keeps the written selector, while its body belongs to the hidden
+/// instance-side initializer emitted by compiler lowering (`init <name>`).
+pub(crate) fn method_body_callable_id(
+    owner: &DeclarationId,
+    method: &MethodDef,
+) -> Option<crate::identity::CallableId> {
+    let slots = method
+        .params
+        .iter()
+        .map(|parameter| {
+            parameter
+                .label
+                .as_ref()
+                .map_or(SelectorSlot::Positional, |label| SelectorSlot::Label(label.clone()))
+        })
+        .collect::<Vec<_>>();
+    let is_constructor = method.is_constructor || method.attributes.iter().any(|attribute| attribute.name == "constructor");
+    let (name, side) = if is_constructor {
+        (format!("init {}", method.name), crate::identity::DispatchSide::Instance)
+    } else {
+        let side = if method.is_static || method.attributes.iter().any(|attribute| attribute.name == "class") {
+            crate::identity::DispatchSide::Class
+        } else {
+            crate::identity::DispatchSide::Instance
+        };
+        (method.name.clone(), side)
+    };
+    let selector = Selector::method(name, slots).ok()?;
+    Some(crate::identity::CallableId::new(owner.clone(), selector, side))
+}
