+
+    let mut before = DeclarationSurface::new(Some(owner.clone()));
+    before.add_field(
+        DispatchSide::Instance,
+        "value",
+        TypeKnowledge::known(ty, EvidenceAuthority::Declared)
+            .with_range(SourceRange::from(10..20)),
