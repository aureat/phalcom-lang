+fn semantic_signature_from_surface(
+    store: &TypeStore,
+    owner: &DeclarationId,
+    callable: &crate::identity::CallableId,
+    signature: &crate::dispatch::CallableSignature,
+) -> Option<crate::signature::CallableSemanticSignature> {
+    let parameters = signature
+        .parameters
+        .iter()
+        .enumerate()
+        .map(|(index, parameter)| {
+            let ty = parameter.ty.ty()?;
+            let mut semantic = crate::signature::CallableParameterSemantic::new(
+                index as u32,
+                parameter.local_name.clone(),
+                semantic_type_term(store, ty),
+            );
+            if let Some(label) = &parameter.external_label {
+                semantic = semantic.with_label(label.clone());
+            }
+            if parameter.rest {
+                semantic = semantic.with_rest(phalcom_ast::ast::RestMode::Positional);
+            }
+            Some(semantic)
+        })
+        .collect::<Option<Vec<_>>>()?
+        .into_boxed_slice();
+    let return_type = semantic_type_term(store, signature.return_type.ty()?);
+
+    Some(crate::signature::CallableSemanticSignature {
+        callable: callable.clone(),
+        owner: owner.clone(),
+        side: callable.side,
+        selector: callable.selector.clone(),
+        generics: signature.generics.clone(),
+        parameters,
+        return_type,
+        source: None,
+        implementation: phalcom_native_meta::ImplementationKind::Source,
+        native_id: None,
+        effects: phalcom_native_meta::EffectSpec::Unknown,
+        raises: phalcom_native_meta::RaisesSpec::Unknown,
+        flow: phalcom_native_meta::ReturnFlowSpec::Value,
+        lifecycle: phalcom_native_meta::NativeLifecycleSpec::UNKNOWN,
+    })
+}
+
+fn semantic_type_term(store: &TypeStore, ty: crate::types::id::TypeId) -> crate::types::parameter::TypeTerm {
+    match store.get(ty) {
+        crate::types::store::TypeData::SelfType(term) => {
+            crate::types::parameter::TypeTerm::SelfType(term.clone())
+        }
+        _ => crate::types::parameter::TypeTerm::Canonical(ty),
+    }
+}
