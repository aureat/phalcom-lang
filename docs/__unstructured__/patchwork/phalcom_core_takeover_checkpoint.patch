+                item.alias.as_ref().map(|alias| alias.name.as_str()).hash(hasher);
+            }
+        }
+        ImportSurface::ReExport(import) => {
+            2u8.hash(hasher);
+            hash_import_path(&import.path, hasher);
+            for item in &import.items {
+                item.local_or_remote_name.hash(hasher);
+                item.alias.as_ref().map(|alias| alias.name.as_str()).hash(hasher);
