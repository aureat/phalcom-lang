+#[test]
+fn constructor_surface_uses_self_and_inherited_dispatch_only_specializes_self() {
+    use phalcom_semantic::types::{SelfRole, TypeData};
+
+    let module = ModuleId::core();
+    let source: Arc<str> = Arc::from(
+        r#"
+class Base {
+  @constructor
+  new() {}
+
+  @class
+  ordinary() -> Base {
+    Base.new()
+  }
+}
+
+class Derived is Base {}
+
+class Probe {
+  @class
+  test {
+    const made = Derived.new()
+    const ordinary = Derived.ordinary()
+  }
+}
+"#,
+    );
+    let program = Arc::new(phalcom_ast::parse(&source, 0).program);
+    let analysis = analyze_single_module(module.clone(), source, program);
+    assert!(!analysis.snapshot.has_errors(), "diagnostics: {:?}", analysis.snapshot.diagnostics);
+
+    let base_decl = DeclarationId::new(module.clone(), "Base".into());
+    let derived_decl = DeclarationId::new(module.clone(), "Derived".into());
+    let base_form = analysis.snapshot.declarations.form(&base_decl).expect("Base form");
+    let derived_form = analysis.snapshot.declarations.form(&derived_decl).expect("Derived form");
+
+    let new_selector = phalcom_common::selector::Selector::method("new", Vec::new()).unwrap();
+    let base_surface = analysis.snapshot.surfaces.get(&base_decl).expect("Base surface");
+    let constructor = base_surface
+        .get_callable(phalcom_semantic::identity::DispatchSide::Class, &new_selector)
+        .expect("public constructor signature");
+    let constructor_return = constructor.return_type.ty().expect("known constructor return");
+    assert!(
+        matches!(
+            analysis.snapshot.store.get(constructor_return),
+            TypeData::SelfType(term)
+                if term.owner == base_decl
+                    && term.side == phalcom_semantic::identity::DispatchSide::Class
+                    && term.role == SelfRole::InstanceType
+        ),
+        "constructor declaration must publish receiver-relative Self rather than Base",
+    );
+
+    let initializer_selector = phalcom_common::selector::Selector::method("init new", Vec::new()).unwrap();
+    let initializer = base_surface
+        .get_callable(phalcom_semantic::identity::DispatchSide::Instance, &initializer_selector)
+        .expect("hidden instance-side initializer signature");
+    let initializer_return = initializer.return_type.ty().expect("known initializer return");
+    assert!(
+        matches!(
+            analysis.snapshot.store.get(initializer_return),
+            TypeData::SelfType(term)
+                if term.owner == base_decl
+                    && term.side == phalcom_semantic::identity::DispatchSide::Instance
+                    && term.role == SelfRole::ReceiverValue
+        ),
+        "initializer body must have receiver-value Self rather than reusing the public factory identity",
+    );
+    assert!(
+        base_surface
+            .get_callable(phalcom_semantic::identity::DispatchSide::Instance, &new_selector)
+            .is_none(),
+        "source constructor must not invent an instance-side `new` callable",
+    );
+
+    let initializer_callable = phalcom_semantic::identity::CallableId::new(
+        base_decl.clone(),
+        initializer_selector,
+        phalcom_semantic::identity::DispatchSide::Instance,
+    );
+    assert!(
+        analysis.snapshot.callable_analyses.contains_key(&initializer_callable),
+        "constructor body analysis must be keyed by the hidden initializer CallableId",
+    );
+    let fake_instance_new = phalcom_semantic::identity::CallableId::new(
+        base_decl.clone(),
+        new_selector.clone(),
+        phalcom_semantic::identity::DispatchSide::Instance,
+    );
+    assert!(
+        !analysis.snapshot.callable_analyses.contains_key(&fake_instance_new),
+        "constructor body analysis must not use a fabricated instance-side `new` CallableId",
+    );
+
+    let probe_decl = DeclarationId::new(module.clone(), "Probe".into());
+    let test_selector = phalcom_common::selector::Selector::getter("test").unwrap();
+    let test_callable = phalcom_semantic::identity::CallableId::new(
+        probe_decl,
+        test_selector,
+        phalcom_semantic::identity::DispatchSide::Class,
+    );
+    let test_analysis = analysis
+        .snapshot
+        .callable_analyses
+        .get(&test_callable)
+        .expect("Probe.test analysis");
+
+    let made = test_analysis.bindings.values().find(|binding| binding.name == "made").expect("made binding");
+    let ordinary = test_analysis
+        .bindings
+        .values()
+        .find(|binding| binding.name == "ordinary")
+        .expect("ordinary binding");
+
+    assert_eq!(made.current.ty(), Some(derived_form), "inherited constructor Self specializes to Derived");
+    assert_eq!(ordinary.current.ty(), Some(base_form), "ordinary explicit -> Base must remain Base");
+}
