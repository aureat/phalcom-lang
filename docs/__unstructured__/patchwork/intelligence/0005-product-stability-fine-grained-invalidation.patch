+        let knowledge = resolve_type_annotation(
+            ctx.store,
+            ctx.declarations,
+            resolver,
+            &ctx.current_module,
+            annotation,
+            &mut diagnostics,
+        );
+        ctx.diagnostics.extend(diagnostics);
+        knowledge
