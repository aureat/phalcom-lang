+#[test]
+fn declaration_surface_query_owns_member_annotation_diagnostics() {
+    use phalcom_semantic::diagnostic::DiagnosticCode;
+
+    let module = ModuleId::resolved(
+        ResolvedProjectId::from_raw(4),
