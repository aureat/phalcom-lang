+  _port: Int = "invalid"
+}
+"#;
+
+    let update = session.update(input(module, source, 1));
+    assert!(
+        update
+            .snapshot
+            .diagnostics
+            .values()
+            .flatten()
+            .any(|diagnostic| diagnostic.code == DiagnosticCode::FieldMismatch),
+        "field initializer checking remains a non-callable class responsibility"
+    );
+}
