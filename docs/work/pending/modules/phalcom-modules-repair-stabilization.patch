@@ -0,0 +1,32 @@
+use phalcom_core::modules::compile::{EntrySelection, ProgramCompiler};
+use phalcom_core::vm::VM;
+use phalcom_core::value::Value;
+use std::fs;
+use tempfile::TempDir;
+
+#[test]
+fn universe_import_survives_closed_program_pipeline_and_observes_export() {
+    let tmp = TempDir::new().unwrap();
+    fs::write(
+        tmp.path().join("project.toml"),
+        "[project]\nname = \"builtin-test\"\nnamespace = \"builtin_test\"\nversion = \"0.1.0\"\nentry = \"builtin_test.main\"\n",
+    )
+    .unwrap();
+    fs::create_dir_all(tmp.path().join("src")).unwrap();
+    fs::write(tmp.path().join("src/package.ph"), "").unwrap();
+    fs::write(
+        tmp.path().join("src/main.ph"),
+        "from universe import Object\nlet observed = Object\nexport observed\n",
+    )
+    .unwrap();
+
+    let program = ProgramCompiler::compile_entry_selection(EntrySelection::Project(tmp.path().to_path_buf())).unwrap();
+    assert!(program.modules.keys().any(|id| matches!(id.project, phalcom_modules::ProjectIdentity::Builtin(_))));
+
+    let mut vm = VM::new();
+    vm.run_compiled(&program).unwrap();
+    let entry = vm.module_registry.get(&program.entry).unwrap().object;
+    let observed = vm.get_or_intern("observed");
+    let slot = vm.heap.module(entry).slot_of(observed).unwrap();
+    assert!(matches!(vm.heap.module(entry).globals[slot], Value::Obj(_)));
+}
