+fn package_context(program: &CompiledProgram, id: &ModuleId) -> Option<ModuleId> {
+    let own_kind = program.modules.get(id)?.kind;
+    if own_kind.is_package_like() {
+        return Some(id.clone());
+    }
+    let components = id.path.components();
+    for depth in (0..components.len()).rev() {
+        let path = ModulePath::from_components(components[..depth].to_vec());
+        let candidate = ModuleId { project: id.project, path };
+        if program.modules.get(&candidate).is_some_and(|module| module.kind.is_package_like()) {
+            return Some(candidate);
+        }
+    }
+    None
