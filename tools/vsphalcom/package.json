{
  "name": "vsphalcom",
  "displayName": "Phalcom VS Code",
  "description": "Phalcom Language Support for VS Code",
  "publisher": "Phalcom",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.79.0"
  },
  "repository": {
    "url": "https://github.com/altunh/vsphalcom"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "phalcom.runFile",
        "title": "Run Phalcom File",
        "category": "Phalcom",
        "icon": "$(play)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "phalcom.runFile",
          "when": "resourceLangId == phalcom",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "phalcom.runFile",
          "when": "resourceLangId == phalcom"
        }
      ]
    },
    "languages": [
      {
        "id": "phalcom",
        "aliases": [
          "Phalcom",
          "phalcom"
        ],
        "extensions": [
          ".ph"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "phalcom",
        "scopeName": "source.phalcom",
        "path": "./syntaxes/phalcom.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Phalcom",
      "properties": {
        "phalcom.executablePath": {
          "type": "string",
          "default": "phalcom",
          "description": "Path to the phalcom CLI executable used by \"Run Phalcom File\" (e.g. target/debug/phalcom for a local build). Defaults to \"phalcom\" on $PATH."
        },
        "phalcom.lsp.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Launch the in-process phalcom-lsp language server (over stdio), providing diagnostics, completion, hover, go-to-definition, find-references, workspace symbols, and semantic tokens. All 5 stages have landed (ADR-0056); this is now the only intelligence provider — disabling it leaves just static TextMate syntax highlighting, with no fallback."
        },
        "phalcom.lsp.serverPath": {
          "type": "string",
          "default": "phalcom-lsp",
          "description": "Path to the phalcom-lsp server executable (e.g. target/debug/phalcom-lsp for a local build). Defaults to \"phalcom-lsp\" on $PATH. Only used when \"phalcom.lsp.enabled\" is true."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.1",
    "@types/node": "20.2.5",
    "@types/vscode": "^1.79.0",
    "@typescript-eslint/eslint-plugin": "^5.59.8",
    "@typescript-eslint/parser": "^5.59.8",
    "@vscode/test-electron": "^2.3.2",
    "eslint": "^8.41.0",
    "glob": "^8.1.0",
    "mocha": "^10.2.0",
    "ts-loader": "^9.4.3",
    "typescript": "^5.1.3",
    "webpack": "^5.85.0",
    "webpack-cli": "^5.1.1"
  },
  "dependencies": {
    "vscode-languageclient": "^8.1.0"
  }
}
