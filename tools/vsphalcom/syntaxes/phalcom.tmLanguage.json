{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "Phalcom",
	"patterns": [
		{ "include": "#phalcom.comment" },
		{ "include": "#phalcom.string" },
		{ "include": "#phalcom.symbol" },
		{ "include": "#phalcom.methodref" },
		{ "include": "#phalcom.attribute" },
		{ "include": "#phalcom.option-operator" },
		{ "include": "#phalcom.index-bracket" },
		{ "include": "#phalcom.number" },
		{ "include": "#phalcom.module" },
		{ "include": "#phalcom.class" },
		{ "include": "#phalcom.keyword" },
		{ "include": "#phalcom.field" },
		{ "include": "#variables" }
	],
	"repository": {
		"phalcom.comment": {
			"patterns": [
				{
					"name": "comment.block.documentation.phalcom",
					"match": "(^|(?<=\\s))//[/!].*$"
				},
				{
					"name": "comment.line.double-slash.phalcom",
					"match": "//.*$"
				},
				{
					"name": "comment.block.phalcom",
					"begin": "/\\*",
					"end": "\\*/"
				}
			]
		},
		"phalcom.string": {
			"name": "string.quoted.double.phalcom",
			"begin": "\"",
			"end": "\"",
			"patterns": [
				{ "include": "#phalcom.interpolation" },
				{
					"name": "constant.character.escape.phalcom",
					"match": "\\\\."
				}
			]
		},
		"phalcom.interpolation": {
			"name": "meta.embedded.line.phalcom",
			"begin": "\\\\\\(",
			"beginCaptures": {
				"0": { "name": "punctuation.section.embedded.begin.phalcom" }
			},
			"end": "\\)",
			"endCaptures": {
				"0": { "name": "punctuation.section.embedded.end.phalcom" }
			},
			"patterns": [
				{ "include": "#phalcom.interpolation.round" },
				{ "include": "#phalcom.symbol" },
				{ "include": "#phalcom.methodref" },
				{ "include": "#phalcom.attribute" },
				{ "include": "#phalcom.option-operator" },
				{ "include": "#phalcom.number" },
				{ "include": "#phalcom.keyword" },
				{ "include": "#phalcom.field" },
				{ "include": "#variables" }
			]
		},
		"phalcom.interpolation.round": {
			"name": "meta.embedded.line.phalcom",
			"begin": "\\(",
			"end": "\\)",
			"patterns": [
				{ "include": "#phalcom.interpolation.round" },
				{ "include": "#phalcom.symbol" },
				{ "include": "#phalcom.methodref" },
				{ "include": "#phalcom.attribute" },
				{ "include": "#phalcom.option-operator" },
				{ "include": "#phalcom.number" },
				{ "include": "#phalcom.keyword" },
				{ "include": "#phalcom.field" },
				{ "include": "#variables" }
			]
		},
		"phalcom.symbol": {
			"patterns": [
				{
					"name": "constant.other.symbol.phalcom",
					"match": "#[a-zA-Z_][a-zA-Z0-9_]*(=(\\([^)]*\\))?|\\([^)]*\\))?"
				},
				{
					"name": "constant.other.symbol.phalcom",
					"match": "#(==|!=|<=|>=|<<|>>|\\+\\+|--|\\+|-|\\*|/|%|<|>|\\[[^\\]]*\\](=(\\([^)]*\\))?)?)"
				}
			]
		},
		"phalcom.methodref": {
			"name": "keyword.operator.methodref.phalcom",
			"match": "::\\s*#?[a-zA-Z_][a-zA-Z0-9_]*(=(\\([^)]*\\))?|\\([^)]*\\))?"
		},
		"phalcom.module": {
			"patterns": [
				{
					"begin": "\\b(from|import|export|expose)\\b",
					"beginCaptures": {
						"0": { "name": "keyword.control.phalcom" }
					},
					"end": "(?=\\r?$)",
					"patterns": [
						{
							"name": "keyword.control.phalcom",
							"match": "\\b(from|import|export|expose|as)\\b"
						},
						{
							"name": "entity.name.namespace.phalcom",
							"match": "(?<![a-zA-Z0-9_])\\.{1,2}(?:\\.[a-zA-Z_][a-zA-Z0-9_]*)*(?:[a-zA-Z_][a-zA-Z0-9_]*)?"
						},
						{ "include": "#variables" }
					]
				}
			]
		},
		"phalcom.class": {
			"patterns": [
				{
					"begin": "(\\bclass\\b)\\s+([A-Z][a-zA-Z0-9_]*)\\s*(?:\\b(is)\\b\\s+[A-Z][a-zA-Z0-9_]*\\s*)?\\{",
					"beginCaptures": {
						"1": { "name": "keyword.control.phalcom" },
						"2": { "name": "entity.name.type.class.phalcom" },
						"3": { "name": "keyword.control.phalcom" }
					},
					"end": "\\}",
					"patterns": [
						{ "include": "#phalcom.comment" },
						{ "include": "#phalcom.string" },
						{ "include": "#phalcom.symbol" },
						{ "include": "#phalcom.methodref" },
						{ "include": "#phalcom.attribute" },
						{ "include": "#phalcom.option-operator" },
						{ "include": "#phalcom.index-bracket" },
						{ "include": "#phalcom.number" },
						{ "include": "#phalcom.keyword" },
						{ "include": "#phalcom.class-member" },
						{ "include": "#phalcom.block" },
						{ "include": "#phalcom.field" },
						{ "include": "#variables" }
					]
				}
			]
		},
		"phalcom.class-member": {
			"patterns": [
				{
					"name": "entity.name.function.phalcom",
					"match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b(?=\\s*=\\s*\\(\\s*put\\b)"
				},
				{
					"name": "entity.name.function.phalcom",
					"match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b(?=\\s*\\([^)]*\\)\\s*\\{)"
				},
				{
					"name": "entity.name.function.phalcom",
					"match": "(?<![a-zA-Z0-9_])(?:\\+\\+|--|==|!=|<=|>=|<<|>>|\\*\\*\\*|\\*\\*|~/|\\?\\?|\\?\\.|\\+|-|\\*|/|%|<|>|&|\\||\\^|~)(?=\\s*\\([^)]*\\)\\s*\\{)"
				},
				{
					"name": "entity.name.function.phalcom",
					"match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b(?=\\s*\\{)"
				},
				{
					"name": "entity.name.function.phalcom",
					"match": "\\[(?=[^\\]]*\\]\\s*(?:=\\s*\\(\\s*put\\b)?\\s*\\{)[^\\]]*\\]"
				}
			]
		},
		"phalcom.block": {
			"begin": "\\{",
			"end": "\\}",
			"patterns": [
				{ "include": "#phalcom.comment" },
				{ "include": "#phalcom.string" },
				{ "include": "#phalcom.symbol" },
				{ "include": "#phalcom.methodref" },
				{ "include": "#phalcom.attribute" },
				{ "include": "#phalcom.option-operator" },
				{ "include": "#phalcom.index-bracket" },
				{ "include": "#phalcom.number" },
				{ "include": "#phalcom.keyword" },
				{ "include": "#phalcom.block" },
				{ "include": "#phalcom.field" },
				{ "include": "#variables" }
			]
		},
		"phalcom.attribute": {
			"patterns": [
				{
					"name": "keyword.control.decorator.phalcom",
					"match": "@(class|constructor|get|set|construct|data|sealed|variant|invariant|requires|ensures|native|ignore|private|protected|On)\\b"
				},
				{
					"name": "entity.name.tag.attribute.phalcom",
					"match": "@[a-zA-Z_][a-zA-Z0-9_]*"
				}
			]
		},
		"phalcom.option-operator": {
			"name": "keyword.operator.option.phalcom",
			"match": "\\?\\.|\\?\\?"
		},
		"phalcom.index-bracket": {
			"name": "punctuation.definition.index.phalcom",
			"match": "\\[|\\]"
		},
		"phalcom.number": {
			"name": "constant.numeric.phalcom",
			"match": "\\b[0-9][0-9_]*(\\.[0-9][0-9_]*)?\\b"
		},
		"phalcom.keyword": {
			"patterns": [
				{
					"name": "keyword.control.phalcom",
					"match": "\\b(let|const|fn|class|is|super|self|static|try|catch|on|ensure|throw|break|continue|match|return|while|for|if|else|true|false|and|or|not|in|as|import|from|export|expose|var|construct)\\b"
				},
				{
					"name": "keyword.operator.phalcom",
					"match": "\\+\\+|--|\\+|-|\\*|/|%|==|!=|<=|>=|<|>|=>|->|=|\\+=|-=|/=|\\*=|%="
				}
			]
		},
		"phalcom.field": {
			"name": "variable.other.field.phalcom",
			"match": "\\b_[a-zA-Z][a-zA-Z0-9_]*\\b"
		},
		"variables": {
			"patterns": [
				{
					"comment": "Capitalized identifier: a class/type reference (Object, System, List, ...). Colored as a type, never as a variable/keyword — applies uniformly whether it's a bare reference (System) or the receiver of a call (Set(1,2,3) is still a class reference per lexical-structure.md §4, not a function call).",
					"name": "entity.name.type.class.phalcom",
					"match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
				},
				{
					"comment": "lowercase identifier immediately followed by '(' — a method/message-send call (obj.foo(...), bare foo(...)). Must come before the plain-variable rule below since it's the more specific match.",
					"name": "entity.name.function.phalcom",
					"match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b(?=\\s*\\()"
				},
				{
					"comment": "lowercase identifier NOT followed by '(' — an ordinary variable/property read (getters included, since a getter send has no parens).",
					"name": "variable.other.readwrite.phalcom",
					"match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
				}
			]
		}
	},
	"scopeName": "source.phalcom"
}
