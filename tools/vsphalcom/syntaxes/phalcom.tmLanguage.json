{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "Phalcom",
	"patterns": [
		{
			"include": "#phalcom.comment"
		},
		{
			"include": "#phalcom.string"
		},
		{
			"include": "#phalcom.symbol"
		},
		{
			"include": "#phalcom.methodref"
		},
		{
			"include": "#phalcom.attribute"
		},
		{
			"include": "#phalcom.option-operator"
		},
		{
			"include": "#phalcom.index-bracket"
		},
		{
			"include": "#phalcom.number"
		},
		{
			"include": "#phalcom.module"
		},
		{
			"include": "#phalcom.type-declaration"
		},
		{
			"include": "#phalcom.trait-declaration"
		},
		{
			"include": "#phalcom.class-declaration"
		},
		{
			"include": "#phalcom.data-declaration"
		},
		{
			"include": "#phalcom.data-variant"
		},
		{
			"include": "#phalcom.impl-declaration"
		},
		{
			"include": "#phalcom.match-pattern"
		},
		{
			"include": "#phalcom.where-clause"
		},
		{
			"include": "#phalcom.contextual-keyword"
		},
		{
			"include": "#phalcom.reserved-keyword"
		},
		{
			"include": "#phalcom.type-lambda"
		},
		{
			"include": "#phalcom.generic-callable-declaration"
		},
		{
			"include": "#phalcom.callable-declaration"
		},
		{
			"include": "#phalcom.generic-call"
		},
		{
			"include": "#phalcom.trailing-closure-call"
		},
		{
			"include": "#phalcom.type-parameter-application"
		},
		{
			"include": "#phalcom.type-application"
		},
		{
			"include": "#phalcom.type-builtin"
		},
		{
			"include": "#phalcom.type-parameter-reference"
		},
		{
			"include": "#phalcom.closure"
		},
		{
			"include": "#phalcom.member-selector"
		},
		{
			"include": "#phalcom.operator-punctuation"
		},
		{
			"include": "#phalcom.field"
		},
		{
			"include": "#variables"
		}
	],
	"repository": {
		"phalcom.comment": {
			"patterns": [
				{
					"name": "comment.block.documentation.phalcom",
					"match": "(^|(?<=\\s))//[/!].*$"
				},
				{
					"name": "comment.line.double-slash.phalcom",
					"match": "//.*$"
				},
				{
					"name": "comment.block.phalcom",
					"begin": "/\\*",
					"end": "\\*/"
				}
			]
		},
		"phalcom.string": {
			"name": "string.quoted.double.phalcom",
			"begin": "\"",
			"end": "\"",
			"patterns": [
				{
					"include": "#phalcom.interpolation"
				},
				{
					"name": "constant.character.escape.phalcom",
					"match": "\\\\."
				}
			]
		},
		"phalcom.interpolation": {
			"name": "meta.embedded.line.phalcom",
			"begin": "\\\\\\(",
			"beginCaptures": {
				"0": {
					"name": "punctuation.section.embedded.begin.phalcom"
				}
			},
			"end": "\\)",
			"endCaptures": {
				"0": {
					"name": "punctuation.section.embedded.end.phalcom"
				}
			},
			"patterns": [
				{
					"include": "#phalcom.data-variant"
				},
				{
					"include": "#phalcom.match-pattern"
				},
				{
					"include": "#phalcom.interpolation.round"
				},
				{
					"include": "#phalcom.symbol"
				},
				{
					"include": "#phalcom.methodref"
				},
				{
					"include": "#phalcom.attribute"
				},
				{
					"include": "#phalcom.option-operator"
				},
				{
					"include": "#phalcom.number"
				},
				{
					"include": "#phalcom.contextual-keyword"
				},
				{
					"include": "#phalcom.reserved-keyword"
				},
				{
					"include": "#phalcom.type-lambda"
				},
				{
					"include": "#phalcom.generic-call"
				},
				{
					"include": "#phalcom.trailing-closure-call"
				},
				{
					"include": "#phalcom.type-parameter-application"
				},
				{
					"include": "#phalcom.type-application"
				},
				{
					"include": "#phalcom.type-builtin"
				},
				{
					"include": "#phalcom.type-parameter-reference"
				},
				{
					"include": "#phalcom.closure"
				},
				{
					"include": "#phalcom.member-selector"
				},
				{
					"include": "#phalcom.operator-punctuation"
				},
				{
					"include": "#phalcom.field"
				},
				{
					"include": "#variables"
				}
			]
		},
		"phalcom.interpolation.round": {
			"name": "meta.embedded.line.phalcom",
			"begin": "\\(",
			"end": "\\)",
			"patterns": [
				{
					"include": "#phalcom.data-variant"
				},
				{
					"include": "#phalcom.match-pattern"
				},
				{
					"include": "#phalcom.interpolation.round"
				},
				{
					"include": "#phalcom.symbol"
				},
				{
					"include": "#phalcom.methodref"
				},
				{
					"include": "#phalcom.attribute"
				},
				{
					"include": "#phalcom.option-operator"
				},
				{
					"include": "#phalcom.number"
				},
				{
					"include": "#phalcom.contextual-keyword"
				},
				{
					"include": "#phalcom.reserved-keyword"
				},
				{
					"include": "#phalcom.type-lambda"
				},
				{
					"include": "#phalcom.generic-call"
				},
				{
					"include": "#phalcom.trailing-closure-call"
				},
				{
					"include": "#phalcom.type-parameter-application"
				},
				{
					"include": "#phalcom.type-application"
				},
				{
					"include": "#phalcom.type-builtin"
				},
				{
					"include": "#phalcom.type-parameter-reference"
				},
				{
					"include": "#phalcom.closure"
				},
				{
					"include": "#phalcom.member-selector"
				},
				{
					"include": "#phalcom.operator-punctuation"
				},
				{
					"include": "#phalcom.field"
				},
				{
					"include": "#variables"
				}
			]
		},
		"phalcom.symbol": {
			"patterns": [
				{
					"name": "constant.other.symbol.phalcom",
					"match": "#[a-zA-Z_][a-zA-Z0-9_]*(=(\\([^)]*\\))?|\\([^)]*\\))?"
				},
				{
					"name": "constant.other.symbol.phalcom",
					"match": "#(\\*{1,3}|~/|<<|>>|==|!=|<=|>=|\\?\\.|\\?\\?|\\.\\.\\.|\\+|-|/|%|&|\\||\\^|~|<|>|!|\\?)"
				}
			]
		},
		"phalcom.methodref": {
			"name": "keyword.operator.methodref.phalcom",
			"match": "::\\s*(?:[a-zA-Z_][a-zA-Z0-9_]*|\\*{1,3}|~/|<<|>>|==|!=|<=|>=|\\+|-|/|%|&|\\||\\^|~|<|>|\\[[^\\]]*\\])(?:=(?:\\([^)]*\\)|\\.\\.\\.)|\\([^)]*\\)|\\.\\.\\.)?"
		},
		"phalcom.module": {
			"patterns": [
				{
					"begin": "\\b(from|import|export|expose)\\b",
					"beginCaptures": {
						"0": {
							"name": "keyword.control.phalcom"
						}
					},
					"end": "(?=\\r?$)",
					"patterns": [
						{
							"name": "keyword.control.phalcom",
							"match": "\\b(from|import|export|expose|as)\\b"
						},
						{
							"name": "entity.name.namespace.phalcom",
							"match": "(?<![a-zA-Z0-9_])(?:(?:\\.{1,3})(?:[a-zA-Z_][a-zA-Z0-9_]*(?:\\.[a-zA-Z_][a-zA-Z0-9_]*)*)?|(?:[a-zA-Z_][a-zA-Z0-9_]*\\.)+[a-zA-Z_][a-zA-Z0-9_]*)"
						},
						{
							"include": "#variables"
						}
					]
				}
			]
		},
		"phalcom.type-declaration": {
			"patterns": [
				{
					"comment": "An unassigned type member is the lexical fallback for an associated type declaration; TextMate cannot distinguish its later references from ordinary type names.",
					"match": "\\b(type)\\s+([A-Z][a-zA-Z0-9_]*)(?=\\s*(?::|\\r?$|//))",
					"captures": {
						"1": {
							"name": "keyword.declaration.phalcom"
						},
						"2": {
							"name": "entity.name.type.associated.phalcom"
						}
					}
				},
				{
					"comment": "Generic type alias declaration, e.g. type Evidence<T> = ...",
					"begin": "\\b(type)\\s+([A-Z][a-zA-Z0-9_]*)\\s*(<)",
					"beginCaptures": {
						"1": {
							"name": "keyword.declaration.phalcom"
						},
						"2": {
							"name": "entity.name.type.alias.phalcom"
						},
						"3": {
							"name": "punctuation.definition.generic.begin.phalcom"
						}
					},
					"end": ">",
					"endCaptures": {
						"0": {
							"name": "punctuation.definition.generic.end.phalcom"
						}
					},
					"patterns": [
						{
							"include": "#phalcom.generic-parameter-declaration"
						}
					]
				},
				{
					"comment": "Non-generic type alias declaration.",
					"match": "\\b(type)\\s+([A-Z][a-zA-Z0-9_]*)",
					"captures": {
						"1": {
							"name": "keyword.declaration.phalcom"
						},
						"2": {
							"name": "entity.name.type.alias.phalcom"
						}
					}
				}
			]
		},
		"phalcom.trait-declaration": {
			"patterns": [
				{
					"comment": "Generic trait declaration, including its type-parameter binders.",
					"begin": "\\b(trait)\\s+([A-Z][a-zA-Z0-9_]*)\\s*(<)",
					"beginCaptures": {
						"1": {
							"name": "keyword.declaration.phalcom"
						},
						"2": {
							"name": "entity.name.type.trait.phalcom"
						},
						"3": {
							"name": "punctuation.definition.generic.begin.phalcom"
						}
					},
					"end": ">",
					"endCaptures": {
						"0": {
							"name": "punctuation.definition.generic.end.phalcom"
						}
					},
					"patterns": [
						{
							"include": "#phalcom.generic-parameter-declaration"
						}
					]
				},
				{
					"comment": "Non-generic trait declaration.",
					"match": "\\b(trait)\\s+([A-Z][a-zA-Z0-9_]*)",
					"captures": {
						"1": {
							"name": "keyword.declaration.phalcom"
						},
						"2": {
							"name": "entity.name.type.trait.phalcom"
						}
					}
				}
			]
		},
		"phalcom.class-declaration": {
			"patterns": [
				{
					"comment": "Generic class declaration, including variance markers in the generic binder.",
					"begin": "\\b(class)\\s+([A-Z][a-zA-Z0-9_]*)\\s*(<)",
					"beginCaptures": {
						"1": {
							"name": "keyword.declaration.phalcom"
						},
						"2": {
							"name": "entity.name.type.class.phalcom"
						},
						"3": {
							"name": "punctuation.definition.generic.begin.phalcom"
						}
					},
					"end": ">",
					"endCaptures": {
						"0": {
							"name": "punctuation.definition.generic.end.phalcom"
						}
					},
					"patterns": [
						{
							"include": "#phalcom.generic-parameter-declaration"
						}
					]
				},
				{
					"comment": "Non-generic class declaration.",
					"match": "\\b(class)\\s+([A-Z][a-zA-Z0-9_]*)",
					"captures": {
						"1": {
							"name": "keyword.declaration.phalcom"
						},
						"2": {
							"name": "entity.name.type.class.phalcom"
						}
					}
				}
			]
		},
		"phalcom.generic-parameter-declaration": {
			"patterns": [
				{
					"comment": "Pack markers precede a generic parameter name in declarations such as <*Elements>.",
					"name": "keyword.operator.unpack.phalcom",
					"match": "\\*{1,3}"
				},
				{
					"name": "storage.modifier.variance.phalcom",
					"match": "[+-](?=[A-Z][a-zA-Z0-9_]*\\b)"
				},
				{
					"name": "entity.name.type.parameter.phalcom",
					"match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
				},
				{
					"name": "punctuation.separator.generic.phalcom",
					"match": ","
				}
			]
		},
		"phalcom.generic-parameter-list": {
			"name": "meta.type.parameters.declaration.phalcom",
			"begin": "<",
			"beginCaptures": {
				"0": {
					"name": "punctuation.definition.generic.begin.phalcom"
				}
			},
			"end": ">",
			"endCaptures": {
				"0": {
					"name": "punctuation.definition.generic.end.phalcom"
				}
			},
			"patterns": [
				{
					"include": "#phalcom.generic-parameter-declaration"
				},
				{
					"include": "#phalcom.type-operator"
				}
			]
		},
		"phalcom.type-lambda": {
			"name": "meta.type.lambda.phalcom",
			"begin": "(<)(?=[+-]?[A-Z][a-zA-Z0-9_]*(?:\\s*,\\s*[+-]?[A-Z][a-zA-Z0-9_]*)*\\s*>\\s*=>>)",
			"beginCaptures": {
				"1": {
					"name": "punctuation.definition.type-parameters.begin.phalcom"
				}
			},
			"end": ">",
			"endCaptures": {
				"0": {
					"name": "punctuation.definition.type-parameters.end.phalcom"
				}
			},
			"patterns": [
				{
					"include": "#phalcom.generic-parameter-declaration"
				}
			]
		},
		"phalcom.where-clause": {
			"name": "meta.type.constraints.phalcom",
			"begin": "\\b(where)\\b",
			"beginCaptures": {
				"1": {
					"name": "keyword.control.constraint.phalcom"
				}
			},
			"end": "(?=\\{)|(?=\\r?$)",
			"patterns": [
				{
					"include": "#phalcom.type-lambda"
				},
				{
					"include": "#phalcom.type-parameter-application"
				},
				{
					"include": "#phalcom.type-application"
				},
				{
					"include": "#phalcom.type-builtin"
				},
				{
					"include": "#phalcom.type-parameter-reference"
				},
				{
					"include": "#phalcom.type-operator"
				},
				{
					"name": "punctuation.separator.constraint.phalcom",
					"match": "[:,]"
				}
			]
		},
		"phalcom.generic-callable-declaration": {
			"comment": "Generic function/method declaration signature. Reserved words are tokenized before this identifier heuristic, and an argument list is required so impl headers and generic type names do not become callable names.",
			"name": "meta.function.declaration.phalcom",
			"begin": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\b(?=\\s*<[^\\r\\n{]*>[^\\r\\n{]*\\([^\\r\\n{]*\\)\\s*(?:->[^\\r\\n{]+)?\\s*\\{)",
			"beginCaptures": {
				"1": {
					"name": "entity.name.function.phalcom"
				}
			},
			"end": "(?=\\s*\\{)",
			"patterns": [
				{
					"include": "#phalcom.generic-parameter-list"
				},
				{
					"include": "#phalcom.callable-parameter-list"
				},
				{
					"include": "#phalcom.where-clause"
				},
				{
					"include": "#phalcom.type-application"
				},
				{
					"include": "#phalcom.type-builtin"
				},
				{
					"include": "#phalcom.type-parameter-reference"
				},
				{
					"include": "#phalcom.type-operator"
				},
				{
					"include": "#variables"
				}
			]
		},
		"phalcom.callable-parameter-list": {
			"name": "meta.function.parameters.phalcom",
			"begin": "\\(",
			"beginCaptures": {
				"0": {
					"name": "punctuation.definition.parameters.begin.phalcom"
				}
			},
			"end": "\\)",
			"endCaptures": {
				"0": {
					"name": "punctuation.definition.parameters.end.phalcom"
				}
			},
			"patterns": [
				{
					"comment": "Rest parameter names stay parameters and get a distinct fallback scope.",
					"match": "(?<![A-Za-z0-9_*])(\\*{1,3})([a-zA-Z_][a-zA-Z0-9_]*)(?=\\s*:)",
					"captures": {
						"1": { "name": "keyword.operator.unpack.phalcom" },
						"2": { "name": "variable.parameter.rest.phalcom" }
					}
				},
				{
					"comment": "The identifier immediately before a parameter type is the local parameter name, after any external label.",
					"match": "(?:\\b_\\s+|\\b[a-zA-Z_][a-zA-Z0-9_]*\\s+)?([a-zA-Z_][a-zA-Z0-9_]*)(?=\\s*:)",
					"captures": {
						"1": { "name": "variable.parameter.function.phalcom" }
					}
				},
				{
					"include": "#phalcom.callable-parameter-list"
				},
				{
					"include": "#phalcom.type-application"
				},
				{
					"include": "#phalcom.type-builtin"
				},
				{
					"include": "#phalcom.type-parameter-reference"
				},
				{
					"include": "#phalcom.type-operator"
				},
				{
					"include": "#variables"
				},
				{
					"name": "punctuation.separator.parameter.phalcom",
					"match": ","
				}
			]
		},
		"phalcom.callable-declaration": {
			"patterns": [
				{
					"comment": "Named function/method declaration with an ordinary parameter list and optional return type.",
					"name": "meta.function.declaration.phalcom",
					"begin": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\b(?=\\s*\\([^\\r\\n]*\\)\\s*(?:->[^\\r\\n{]+)?\\s*\\{)",
					"beginCaptures": {
						"1": { "name": "entity.name.function.phalcom" }
					},
					"end": "(?=\\s*\\{)",
					"patterns": [
						{ "include": "#phalcom.callable-parameter-list" },
						{ "include": "#phalcom.type-application" },
						{ "include": "#phalcom.type-builtin" },
						{ "include": "#phalcom.type-parameter-reference" },
						{ "include": "#phalcom.type-operator" },
						{ "include": "#variables" }
					]
				},
				{
					"comment": "Operator method declaration.",
					"name": "meta.function.declaration.phalcom",
					"begin": "(?<![a-zA-Z0-9_])((?:\\+\\+|--|==|!=|<=|>=|<<|>>|\\*\\*\\*|\\*\\*|~/|\\?\\?|\\?\\.|\\+|-|\\*|/|%|<|>|&|\\||\\^|~))(?=\\s*\\([^\\r\\n]*\\)\\s*(?:->[^\\r\\n{]+)?\\s*\\{)",
					"beginCaptures": {
						"1": { "name": "entity.name.function.phalcom" }
					},
					"end": "(?=\\s*\\{)",
					"patterns": [
						{ "include": "#phalcom.callable-parameter-list" },
						{ "include": "#phalcom.type-application" },
						{ "include": "#phalcom.type-builtin" },
						{ "include": "#phalcom.type-parameter-reference" },
						{ "include": "#phalcom.type-operator" },
						{ "include": "#variables" }
					]
				},
				{
					"comment": "Indexer method declaration.",
					"name": "entity.name.function.phalcom",
					"match": "\\[(?=[^\\]]*\\]\\s*(?:=\\s*\\(\\s*put\\b)?\\s*\\{)[^\\]]*\\]"
				}
			]
		},
		"phalcom.generic-call": {
			"comment": "Generic call or message send, including ordinary and trailing-closure forms: map<Int>(...), .map<Int>(...), map<Int> |x| {...}, .map<Int> |x| {...}.",
			"name": "meta.function-call.generic.phalcom",
			"begin": "\\b([a-zA-Z_][a-zA-Z0-9_]*)(<)(?=[^\\r\\n>]*>\\s*(?:\\(|\\|))",
			"beginCaptures": {
				"1": {
					"name": "entity.name.function.phalcom"
				},
				"2": {
					"name": "punctuation.definition.generic.begin.phalcom"
				}
			},
			"end": ">(?=\\s*(?:\\(|\\|))",
			"endCaptures": {
				"0": {
					"name": "punctuation.definition.generic.end.phalcom"
				}
			},
			"patterns": [
				{
					"include": "#phalcom.type-lambda"
				},
				{
					"include": "#phalcom.type-parameter-application"
				},
				{
					"include": "#phalcom.type-application"
				},
				{
					"include": "#phalcom.type-builtin"
				},
				{
					"include": "#phalcom.type-parameter-reference"
				},
				{
					"include": "#phalcom.type-operator"
				},
				{
					"name": "punctuation.separator.generic.phalcom",
					"match": ","
				}
			]
		},
		"phalcom.trailing-closure-call": {
			"comment": "Bare call using trailing-closure syntax: flatMap |value| { ... }. Dot-prefixed forms are also covered by phalcom.member-selector.",
			"name": "entity.name.function.phalcom",
