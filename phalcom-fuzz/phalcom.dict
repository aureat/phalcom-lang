# libFuzzer dictionary for Phalcom source.
# Pass with:  cargo +nightly fuzz run parser -- -dict=fuzz/phalcom.dict
# Tokens are drawn from phalcom-ast/src/token.rs so the fuzzer spends its
# mutation budget on syntactically meaningful fragments instead of rediscovering
# keywords and operators byte by byte.

# --- keywords ---
"let"
"const"
"class"
"return"
"true"
"false"
"if"
"else"
"while"
"for"
"break"
"continue"
"import"
"self"
"super"
"in"
"as"
"is"
"and"
"or"
"not"
"pub"

# --- multi-character operators / punctuation ---
"++"
"--"
"+="
"-="
"*="
"/="
"~/="
"%="
"=="
"!="
"<="
">="
"~/"
"**"
"::"
".."
"..."
"->"
"=>"
"#{"

# --- single-character operators / punctuation ---
"="
"<"
">"
"+"
"-"
"*"
"/"
"%"
"("
")"
"{"
"}"
"["
"]"
";"
":"
","
"."
"?"
"!"
"@"
"&"
"|"

# --- closure literals and trailing closures ---
"|| {}"
"|x| x"
"|x| { x }"
"|x, y| { x }"
".map |x| { x }"
".map |_| { true }"
".new { 1 }"
".new |x| { x }"
".new |x, y| { x }"
"where: |x| { x }"
"where: |x, y| { x + y == 10 }"

# --- literal shapes ---
"\"str\""
"123"
"1.5"
"ident"
"None"
"Some(123)"
"[1, 2, 3]"
"(1, 2, 3)"
"{ x: 1, y: 2 }"
"#{ x: 1, y: 2 }"
"(1, 2, a: 3, b: 4)"
"(*: x, **: y)"
"(***: Int)"
"[\"a\", \"b\", \"c\"]"

# --- small structural fragments ---
"class C {}"
"class C is D {}"
"@data class C {}"
"@data class C is D {}"
"@data class C { _x"
"let x = 1"
"const C = 1"
"_field"
"_$attach"
"__matchArm"
"empty?"
"@requires(x > 0)"
"@requires(a == b and c < _$field)"
"@ensures(old(_x) == new(_x))"
"@construct"
"@constructor"
"@class"
"@sealed"
"@private"
"@public"