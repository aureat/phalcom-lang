    Choice.integer(value: 2, min: 0, max: 3, shrinkTowards: 0, label: Some.new(#length)),
    Choice.integer(value: 7, min: 0, max: 9, shrinkTowards: 0, label: None),
    Choice.integer(value: 8, min: 0, max: 9, shrinkTowards: 0, label: None)
  ],
  spans: const [],
  generationSize: 4
)
