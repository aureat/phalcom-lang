let [(nested_x, nested_y), last] = [(1, 2), 3]


// ---------------------------------------------------------------------------
// Sends, selectors, references, indexing, labels, and expansion lanes
// ---------------------------------------------------------------------------

let demo = Demo.new("reader", 7)
demo.name
demo.name = "writer"
